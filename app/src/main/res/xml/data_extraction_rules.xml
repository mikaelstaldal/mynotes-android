<?xml version="1.0" encoding="utf-8"?>
<!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
    </cloud-backup>
    <device-transfer>
        <!--
           Transfer all app data to the new device, EXCEPT the encrypted
           credential store. Its master key lives in the AndroidKeyStore, which
           never leaves the device, so a copied secret_shared_prefs.xml would be
           undecryptable on the target (AEADBadTagException). Excluding it means
           a migrated install degrades to "please log in again" instead.
        -->
        <include domain="root" path="."/>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="secret_shared_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
